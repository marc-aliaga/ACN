# Copia este archivo a .env.local (ignorado por git) y rellena los valores.
# Sin estas variables la web funciona igual, pero no registra leads ni analítica.

# PostHog (Project settings > Project API key)
VITE_POSTHOG_PROJECT=
VITE_POSTHOG_HOST=https://eu.i.posthog.com

# Supabase (Project settings > API): URL y clave pública (publishable / anon)
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE=
